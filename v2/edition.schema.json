{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APF Edition V2",
  "type": "object",
  "required": [
    "vol",
    "edition_date",
    "master_sha256",
    "articles",
    "book",
    "insight",
    "status"
  ],
  "properties": {
    "vol": {
      "type": "integer",
      "minimum": 1
    },
    "edition_date": {
      "type": "string",
      "format": "date"
    },
    "master_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ]
    },
    "articles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "title",
          "original_url",
          "body_verified",
          "verified_facts",
          "event_key",
          "image"
        ],
        "properties": {
          "slot": {
            "enum": [
              "women",
              "beauty",
              "academic",
              "culture",
              "youth",
              "editor"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "original_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "body_verified": {
            "type": "boolean"
          },
          "verified_facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "event_key": {
            "type": "string",
            "minLength": 5
          },
          "image": {
            "type": "object",
            "required": [
              "source_url",
              "sha256",
              "verified",
              "embedded"
            ],
            "properties": {
              "source_url": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              },
              "embedded": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "book": {
      "type": "object",
      "required": [
        "title",
        "author",
        "official_url",
        "cover_sha256",
        "cover_verified"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "official_url": {
          "type": "string"
        },
        "cover_sha256": {
          "type": "string"
        },
        "cover_verified": {
          "type": "boolean"
        }
      }
    },
    "insight": {
      "type": "string",
      "minLength": 30
    }
  }
}